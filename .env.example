# REFERENCIA. El programa no carga .env automáticamente.
# En Render: Environment. En local: variables del proceso / gestor de secretos.
# No reemplaces estos ejemplos con secretos dentro del repositorio.
ERP_ENV=production
PUBLIC_BASE_URL=https://REEMPLAZAR.onrender.com

# Supabase > Connect > Session pooler. Copia el HOST real (no lo deduzcas).
# Usuario del rol de aplicación creado con migrate_data.py bootstrap.
# Codifica caracteres especiales de la contraseña para una URL.
DATABASE_URL=postgresql://erp_app.PROJECT_REF:REEMPLAZAR_PASSWORD@HOST_DEL_SESSION_POOLER:5432/postgres?sslmode=verify-full
ERP_DB_SSL_MODE=verify-full
ERP_DB_SSL_ROOT_CERT=/etc/secrets/supabase-ca.crt
ERP_DB_POOL_SIZE=8
# Obligatorio: Secret File supabase-ca.crt con la CA descargada desde Supabase.
# En migraciones locales usa la ruta local a ese certificado.

# Genera hashes con python auth_config.py hash-password.
# JSON de usuarios completo, sin contraseñas en claro ni las contraseñas demo.
# Este ejemplo no es una credencial válida; debes reemplazar REEMPLAZAR_HASH.
ERP_USERS_JSON={"gerencia":{"role":"manager","branch":null,"passwordHash":"REEMPLAZAR_HASH"},"contabilidad":{"role":"accounting","branch":null,"passwordHash":"REEMPLAZAR_HASH"},"boleteria.potosi":{"role":"ticketing","branch":"Potosí","passwordHash":"REEMPLAZAR_HASH"}}
# PUBLIC_BASE_URL ya está permitido. Añade otro origen HTTPS solo si lo necesitas.
# ERP_ALLOWED_ORIGINS=https://otro-origen-autorizado.example

# Iniciar con impresión manual. Activar agente después de configurar las cajas.
ERP_PRINT_MODE=manual
# ERP_PRINT_AGENTS_JSON={"potosi-caja-1":{"user":"boleteria.potosi","tokenSha256":"REEMPLAZAR_HUELLA_SHA256"}}

# Correo desactivado hasta disponer del servicio SMTP de la empresa.
ERP_PAYROLL_MAIL_ENABLED=false
# ERP_SMTP_HOST=smtp.proveedor.example
# ERP_SMTP_PORT=587
# ERP_SMTP_SECURITY=starttls
# ERP_SMTP_USER=REEMPLAZAR_USUARIO
# ERP_SMTP_PASSWORD=REEMPLAZAR_SECRETO
# ERP_SMTP_FROM=nominas@su-dominio.example

# Solo para preparación/migraciones desde equipo autorizado. NUNCA en Render.
# Usa propietario postgres.PROJECT_REF a través del Session pooler.
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:REEMPLAZAR_PASSWORD@HOST_DEL_SESSION_POOLER:5432/postgres?sslmode=verify-full
